[Unit]
Description=NMRProcFlow Application
Documentation=
After=docker.service
Wants=

[Service]
Type=oneshot
ExecStartPre=/usr/local/bin/dockpurge
ExecStart=/usr/local/bin/npflow start
ExecStop=/usr/local/bin/npflow stop
ExecReload=/usr/local/bin/npflow restart
LimitNOFILE=1048576
LimitNPROC=1048576
LimitCORE=infinity
MountFlags=slave
RemainAfterExit=True

[Install]
WantedBy=multi-user.target

